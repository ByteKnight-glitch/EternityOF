# Android fstab file.
# <src>                                 <mnt_point>         <type>    <mnt_flags>                                            <fs_mgr_flags>
/dev/block/bootdevice/by-name/userdata   /data               f2fs      noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic  wait,check,quota,reservedsize=128M
/dev/block/bootdevice/by-name/misc       /misc               emmc      defaults                                            defaults,first_stage_mount
/dev/block/bootdevice/by-name/cache      /cache              f2fs      nosuid,nodev,noatime,nodiratime,discard,journal_checksum,data=ordered          wait,check
tmpfs                                    /tmp                tmpfs     defaults                                             defaults
/dev/block/bootdevice/by-name/system     /system            ext4      rw,barrier=1                                        wait,check
/dev/block/bootdevice/by-name/vendor     /vendor            ext4      rw,barrier=1                                        wait,check
